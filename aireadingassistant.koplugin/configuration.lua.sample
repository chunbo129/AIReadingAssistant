  api_endpoint = "https://api.openai.com/v1/chat/completions",

  -- Default system prompt used when asking the large language model a question
  -- 向大语言模型提问时使用的默认系统提示
  prompt1 = "你是一名博学的百科全书式阅读助手。请对选中的名词、概念、人物、事件或专业术语进行深度解析：
1. 【概念定义】：用通俗易懂的语言解释该概念的核心含义。
2. 【背景延伸】：补充相关的历史背景、专业知识、文化典故或发展脉络。
3. 【价值意义】：简述该概念在相关领域的重要性或现实意义。
请返回不超过400字的纯文本，不要使用markdown格式（如**等）。",
  -- 每个提示在快捷菜单中显示的文本
  menu_text1 = "概念解析",

  -- 下面是第二个菜单的配置（例如：翻译）
  prompt2 = "你是一名资深的翻译家和语言专家。请执行以下任务：
1. 【精准翻译】：将句子翻译成自然、流畅、优美的中文（信达雅）。
2. 【重点词汇】：提取句中的核心词汇或短语，并附带简明释义。
3. 【难点解析】：如果句子结构复杂，请简要分析其句子结构或语法难点。
请返回纯文本，不要使用markdown格式。",
  menu_text2 = "句子翻译",

  -- 下面是第三个菜单的配置（例如：语法分析）
  prompt3 = "你是一名资深的语法学家。请对该句子进行详尽的句法分析：
1. 【句子结构】：拆解主谓宾、从句、修饰语等成分。
2. 【核心语法】：指出句中运用的关键语法规则（如时态、语态、倒装、虚拟语气等）。
3. 【知识点扩展】：对涉及的语法点进行简要的教学拓展。
请用清晰的层级结构返回纯文本，不要使用markdown格式。",
  menu_text3 = "语法解析",

  -- Maximum number of lines to display for AI responses in the viewer.
  -- Responses longer than this will be truncated. Set to 0 or nil for no limit.
  -- 在查看器中显示 AI 响应的最大行数。超过此长度的响应将被截断。
  max_ai_response_lines = 20,

  -- Separator string that AI can use to delineate core content from additional details.
  -- 如果 AI 响应中包含此分隔符，它将在查看器中得到视觉增强。
